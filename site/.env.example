# URL pública do site (usada em canonical, sitemap, hreflang e Open Graph)
NEXT_PUBLIC_SITE_URL="https://aidepoficial.com"

# ---------------------------------------------------------------------------
# PAINEL DE CONTEÚDO (/admin) — Supabase
# ---------------------------------------------------------------------------
# As duas chaves ficam no painel do Supabase, em Project Settings → API.
# A chave publicável é pública de propósito: quem protege os dados é o RLS
# declarado em supabase/migrations/0001_plataforma.sql.
#
# Sem elas, o site continua funcionando normalmente com o conteúdo estático
# de src/content — só o painel fica indisponível.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Senha do banco (Project Settings → Database). Só os scripts de terminal
# usam — `npm run db:migrate`, `npm run admin:criar`, `npm run db:conferir`.
# O site nunca precisa dela.
SUPABASE_PASSWORD=""

# ---------------------------------------------------------------------------
# Conteúdo de demonstração
# ---------------------------------------------------------------------------
# Conteúdo de exemplo — notícias e documentos de transparência de demonstração.
# Vem LIGADO por padrão, para que as páginas possam ser avaliadas preenchidas.
# Só aparece enquanto o painel estiver vazio: assim que houver uma notícia ou
# um documento publicado no Supabase, o conteúdo real manda sozinho.
# Com "0", as listas voltam a ser vazias e as páginas exibem o estado vazio
# institucional.
NEXT_PUBLIC_EXAMPLE_CONTENT=""

# Fotografias de banco (Pexels) usadas enquanto a fotografia oficial não chega.
# Só é necessária para rodar `npm run images:stock`; as imagens já baixadas
# ficam versionadas em public/images/stock/.
# Chave grátis, sem cartão: https://www.pexels.com/api/
PEXELS_API_KEY=""
