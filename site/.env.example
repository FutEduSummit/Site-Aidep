# URL pública do site (usada em canonical, sitemap, hreflang e Open Graph)
NEXT_PUBLIC_SITE_URL="https://aidepoficial.com"

# Endpoint que recebe os formulários de Contato e de Parcerias.
# Enquanto esta variável não estiver definida, os formulários validam os dados,
# NÃO exibem sucesso falso e oferecem o e-mail institucional como alternativa.
CONTACT_WEBHOOK_URL=""

# Pré-visualização (ferramenta de trabalho, não é conteúdo do site).
# Com "1", a build inclui:
#   • as imagens de exemplo geradas por IA e o interruptor que alterna entre
#     elas e o painel institucional;
#   • o conteúdo de exemplo — notícias e documentos de transparência de
#     demonstração, para apresentar as páginas preenchidas.
# Em `next dev` já vem ligado.
# NUNCA deixe isto ligado na build pública final: nada disso é conteúdo real
# da associação.
NEXT_PUBLIC_PREVIEW_IMAGES=""

# Chave grátis, sem cartão: https://www.pexels.com/api/
PEXELS_API_KEY=""
