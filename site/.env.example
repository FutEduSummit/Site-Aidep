# URL pública do site (usada em canonical, sitemap, hreflang e Open Graph)
NEXT_PUBLIC_SITE_URL="https://aidepoficial.com"

# ---------------------------------------------------------------------------
# PAINEL DE CONTEÚDO (/admin) — Supabase
# ---------------------------------------------------------------------------
# As duas chaves ficam no painel do Supabase, em Project Settings → API.
# A chave publicável é pública de propósito: quem protege os dados é o RLS
# declarado em supabase/migrations/0001_plataforma.sql.
#
# Sem elas, o site continua funcionando normalmente com o conteúdo estático
# de src/content — só o painel fica indisponível.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Senha do banco (Project Settings → Database). Só os scripts de terminal
# usam — `npm run db:migrate`, `npm run admin:criar`, `npm run db:conferir`.
# O site nunca precisa dela.
SUPABASE_PASSWORD=""

# ---------------------------------------------------------------------------
# Formulários e conteúdo de demonstração
# ---------------------------------------------------------------------------
# ENVIO DOS FORMULÁRIOS DE CONTATO E PARCERIAS — por e-mail (Resend)
#
# Enquanto as três variáveis abaixo não estiverem preenchidas, os formulários
# validam os dados, NÃO exibem sucesso falso e oferecem o e-mail institucional
# como alternativa, com assunto e corpo já prontos.
#
# Como habilitar, em 4 passos:
#   1. Crie a conta grátis em https://resend.com (3.000 e-mails/mês, sem cartão)
#   2. Em Domains, verifique aidepoficial.com (a Resend mostra os registros DNS)
#   3. Em API Keys, gere uma chave e cole em RESEND_API_KEY
#   4. Preencha os dois endereços abaixo
RESEND_API_KEY=""

# Quem RECEBE as mensagens. É AQUI que se escolhe o e-mail de destino:
# trocar de endereço é editar esta linha, sem tocar em código.
# Aceita mais de um, separados por vírgula:
#   CONTACT_TO_EMAIL="atendimento@aidepoficial.com,diretoria@aidepoficial.com"
CONTACT_TO_EMAIL=""

# Quem APARECE como remetente. Precisa ser do domínio verificado no passo 2 —
# não pode ser um Gmail/Outlook comum, senão a Resend recusa o envio.
# Sugestão: CONTACT_FROM_EMAIL="Site AIDEP <site@aidepoficial.com>"
#
# Para TESTAR antes de ter o domínio: use "onboarding@resend.dev" aqui e o
# e-mail da sua própria conta Resend em CONTACT_TO_EMAIL. Esse remetente de
# teste só entrega para o dono da conta — não serve para produção.
CONTACT_FROM_EMAIL=""

# Opcional: endpoint extra que recebe uma cópia dos formulários em JSON
# (CRM, planilha, Zapier). Funciona junto com o e-mail ou sozinho.
CONTACT_WEBHOOK_URL=""

# Conteúdo de exemplo — notícias e documentos de transparência de demonstração.
# Vem LIGADO por padrão, para que as páginas possam ser avaliadas preenchidas.
# Só aparece enquanto o painel estiver vazio: assim que houver uma notícia ou
# um documento publicado no Supabase, o conteúdo real manda sozinho.
# Com "0", as listas voltam a ser vazias e as páginas exibem o estado vazio
# institucional.
NEXT_PUBLIC_EXAMPLE_CONTENT=""

# Fotografias de banco (Pexels) usadas enquanto a fotografia oficial não chega.
# Só é necessária para rodar `npm run images:stock`; as imagens já baixadas
# ficam versionadas em public/images/stock/.
# Chave grátis, sem cartão: https://www.pexels.com/api/
PEXELS_API_KEY=""
