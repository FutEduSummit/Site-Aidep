    "db:conferir": "node --env-file-if-exists=.env scripts/conferir-banco.mjs",
    "admin:criar": "node --env-file-if-exists=.env scripts/criar-admin.mjs",
    "conteudo:semear": "node --env-file-if-exists=.env scripts/semear-conteudo.mjs",
    "images:stock": "node scripts/fetch-stock-images.mjs",
