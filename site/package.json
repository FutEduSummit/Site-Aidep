    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
