{
  "name": "aidep-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da AIDEP — Associação Internacional para o Desenvolvimento do Desporto e Paradesporto",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
